---
const { locale = 'es' } = Astro.props
---

<div class="cookie-banner" id="cookieBanner">
  <p>{locale === 'es' ? 'Usamos cookies para mejorar tu experiencia. Al continuar navegando aceptás nuestra política de cookies.' : locale === 'en' ? 'We use cookies to improve your experience. By continuing you accept our cookie policy.' : 'Usamos cookies para melhorar sua experiência. Ao continuar navegando você aceita nossa política de cookies.'}</p>
  <button id="cookieAccept" class="btn btn-primary btn-sm">
    {locale === 'es' ? 'Aceptar' : locale === 'en' ? 'Accept' : 'Aceitar'}
  </button>
</div>

<script>
  const banner = document.getElementById('cookieBanner')
  const btn = document.getElementById('cookieAccept')
  if (localStorage.getItem('cookie-consent')) { banner.style.display = 'none' }
  btn?.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'true')
    banner.style.display = 'none'
  })
</script>

<style is:global>
  .cookie-banner {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--bg-dark);
    color: white;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    z-index: 200;
    flex-wrap: wrap;
  }
  .cookie-banner p { font-size: 0.85rem; color: #94a3b8; max-width: 600px; }
</style>
